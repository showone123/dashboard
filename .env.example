# =============================================================================
#  .env.example — 铜数据看板 · 订阅版
# =============================================================================
#  ⚠️ 先读这段，否则会误解这份文件的作用：
#
#  本项目**没有服务端密钥**。它是一个纯前端应用：
#    · 页面直接由静态服务器发给浏览器，浏览器再直连云服务（Auth / Database / Storage）；
#    · 云服务凭据用的是 publishableKey —— 顾名思义是**可公开下发**的，本来就会出现在
#      浏览器能看到的 HTML 里，把它当 secret 藏起来没有意义（藏了也会被抓包看到）。
#    · 真正的权限边界在服务端：数据库 RLS + 表级 GRANT（见 db/DB_SCHEMA.sql）。
#      所以「前端能不能越权」不取决于前端代码，取决于数据库策略。
#
#  因此这份文件里的值**都不是秘密**，它的用途是「集中说明有哪些可配项」，
#  方便换环境（比如给客户私有部署一份）时不用在源码里翻。
#
#  ⚠️ 两个部署侧的硬约束（违反会导致 WorkBuddy 发布直接被拒）：
#   1. **不要把本文件放进 dist/**。发布前的预检查会扫描 `.env*`，
#      如果里面出现指向 localhost / 容器名的数据库连接串（如 postgres://localhost、redis://…），
#      整个项目会被判定为「依赖沙箱不提供的外部服务」而拒绝发布。
#      本项目用的是**公开托管的云数据库**，本来就不需要连接串，所以请让它留在仓库根目录。
#   2. **不要引入任何数据库驱动依赖**（pg / psycopg2 / mysql2 / mongoose / ioredis …）。
#      发布预检查会读依赖清单，出现这些包名同样会被拒。前端直连 HTTP API，不需要驱动。
#
#  注意：当前构建脚本不会自动读取本文件。这里是环境配置参考；生产值仍由
#  build/app.js 与 WorkBuddy 部署参数共同确定。需要多环境时应先实现显式注入。
# =============================================================================


# -----------------------------------------------------------------------------
# 一、云服务接入（当前值与 build/app.js 保持一致，可公开）
# -----------------------------------------------------------------------------
# 云服务网关地址。浏览器拿它拼出 /.cloud/auth、/.cloud/database/rest、/.cloud/storage 三个前缀。
WB_CLOUD_ENDPOINT=https://data-dashboard-85191.app.workbuddy.host

# 可公开下发的接入 Key。请求时放在 x-wb-webapp-access-key 头里。
# ⚠️ 头名必须是 x-wb-webapp-access-key，写成 apikey 会返回 invalid_client。
WB_CLOUD_PUBLISHABLE_KEY=wbpk_SzEJc2waV6zqr78qhIU3M1_EsOOC55rzH5Grlz0kErY9VMacOE30GRa

# 应用 ID。发布时作为 sites 工具的 appId 复用（不要 createNewApp，
# 新建应用会换域名，云登录会因为 Origin 不匹配而失效）。
WB_APP_ID=wbapp_SzEJc2waV6zqr78qhIU3M1


# -----------------------------------------------------------------------------
# 二、静态服务器（dist/server.py 读取）
# -----------------------------------------------------------------------------
# 监听端口。WorkBuddy 发布沙箱会注入 PORT，本地不起作用时默认 3000。
# 服务器固定绑定 0.0.0.0（沙箱要求）。
PORT=3000


# -----------------------------------------------------------------------------
# 三、本地调试开关（仅开发用，不影响线上）
# -----------------------------------------------------------------------------
# 离线版本不读取环境变量，请显式运行：python vendor_deps.py --apply
# 该命令生成的 *.vendor.html 需要 vendor/ 目录，不要用于线上发布。
